# --- secrets / local config ---
# Note: js/config.js is committed on purpose — it only holds the Supabase
# *publishable* key, which is meant to be public (browser-safe). Never put a
# service_role / secret key in this front-end.
.env
.env.local

# AWS backend (MoniumApp/) — account IDs, key pairs, downloaded IAM CSVs
.env-aws
*_accessKeys.csv
credentials.csv
lambda-trust-policy.json

# --- editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- node (only if you add a build tool later) ---
node_modules/
dist/
*.log
